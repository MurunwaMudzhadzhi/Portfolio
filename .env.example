# Copy this file to .env and fill in your values
# cp .env.example .env

PORT=3000

# JWT
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRES_IN=7d

# Admin credentials (used by db/seed.js)
ADMIN_USERNAME=murunwa
ADMIN_PASSWORD=ChangeMe123!

# SQLite DB path (default: ./db/portfolio.sqlite)
# DB_PATH=./db/portfolio.sqlite

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000

# Nodemailer (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
CONTACT_TO=your@email.com
